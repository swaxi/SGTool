<metadata xml:lang="en"><Esri><CreaDate>20261030</CreaDate><CreaTime>11591900</CreaTime><ArcGISFormat>1.0</ArcGISFormat><SyncOnce>TRUE</SyncOnce><ModDate>20261030</ModDate><ModTime>11591900</ModTime></Esri><tool name="DirectionalButterworthFilter" displayname="Directional Butterworth Band-Pass Filter" toolboxalias="sgtool" xmlns=""><arcToolboxHelpPath>c:\program files\arcgis\pro\Resources\Help\gp</arcToolboxHelpPath><summary>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Directional Butterworth band-pass filter: keeps a band of wavelengths within a wedge of directions about an azimuth.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</summary><usage>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;To remove survey line noise, use Remove Line Noise, which estimates the noise this way and subtracts it.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</usage><parameters><param name="in_raster" displayname="Input Raster" type="Required" direction="Input" datatype="GPRasterLayer" expression="in_raster"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Grid to process (a single-band raster; no-data cells are left as no-data in the result).&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Grid to process (a single-band raster; no-data cells are left as no-data in the result).&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="out_raster" displayname="Output Raster" type="Required" direction="Output" datatype="DERasterDataset" expression="out_raster"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Output raster (GeoTIFF), with the input's extent, cell size and coordinate system.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Output raster (GeoTIFF), with the input's extent, cell size and coordinate system.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="low_cut" displayname="Short-wavelength Cut (map units)" type="Required" direction="Input" datatype="GPDouble" expression="low_cut"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Shortest wavelength kept (map units).&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Shortest wavelength kept (map units).&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="high_cut" displayname="Long-wavelength Cut (map units)" type="Required" direction="Input" datatype="GPDouble" expression="high_cut"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Longest wavelength kept (map units).&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Longest wavelength kept (map units).&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="direction" displayname="Azimuth Direction (°, N=0)" type="Required" direction="Input" datatype="GPDouble" expression="direction"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Azimuth of the wedge, degrees clockwise from north.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Azimuth of the wedge, degrees clockwise from north.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="direction_width" displayname="Direction Width (°)" type="Required" direction="Input" datatype="GPDouble" expression="direction_width"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Half-width of the wedge, in degrees.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Half-width of the wedge, in degrees.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="order" displayname="Butterworth Order" type="Required" direction="Input" datatype="GPLong" expression="order"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Butterworth filter order: higher is a sharper cut-off.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Butterworth filter order: higher is a sharper cut-off.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="buffer_size" displayname="FFT Buffer (pixels, 0 = automatic)" type="Optional" direction="Input" datatype="GPLong" expression="buffer_size"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;FFT buffer in pixels added around the grid before the Fourier transform, to reduce edge effects. 0 (the default) chooses it as in QGIS: the shorter side of the grid, up to 5000. A value greater than 0 is used as that upper limit instead.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;FFT buffer in pixels added around the grid before the Fourier transform, to reduce edge effects. 0 (the default) chooses it as in QGIS: the shorter side of the grid, up to 5000. A value greater than 0 is used as that upper limit instead.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param></parameters></tool><dataIdInfo><idCitation><resTitle>Directional Butterworth Band-Pass Filter</resTitle></idCitation><idAbs>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Directional Butterworth band-pass filter: keeps a band of wavelengths within a wedge of directions about an azimuth.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</idAbs><searchKeys><keyword>SGTool</keyword><keyword>geophysics</keyword></searchKeys><idPurp>Directional Butterworth band-pass filter: keeps a band of wavelengths within a wedge of directions about an azimuth.</idPurp></dataIdInfo><distInfo><distributor><distorFormat><formatName>ArcToolbox Tool</formatName></distorFormat></distributor></distInfo><mdHrLv><ScopeCd value="005"/></mdHrLv></metadata>
