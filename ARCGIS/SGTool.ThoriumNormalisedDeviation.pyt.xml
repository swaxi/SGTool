<metadata xml:lang="en"><Esri><CreaDate>20261118</CreaDate><CreaTime>12441200</CreaTime><ArcGISFormat>1.0</ArcGISFormat><SyncOnce>TRUE</SyncOnce><ModDate>20261118</ModDate><ModTime>12441200</ModTime></Esri><tool name="ThoriumNormalisedDeviation" displayname="Kd / Ud (Thorium-Normalised Deviation)" toolboxalias="sgtool" xmlns=""><arcToolboxHelpPath>c:\program files\arcgis\pro\Resources\Help\gp</arcToolboxHelpPath><summary>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Kd or Ud, the thorium-normalised deviation of K or eU (Saunders et al. 1987; Pires 1995): Kd = (K - Ks) / Ks, with Ks the K predicted from eTh over the whole grid. Positive where there is more K (or U) than the thorium predicts for the rock type.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</summary><usage>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;K, eU and eTh can be bands of one multi-band raster or separate rasters; the result is written on the K raster's grid.&lt;/SPAN&gt;&lt;/P&gt;&lt;P&gt;&lt;SPAN&gt;Cells where the predicted value is below 10% of the mean are left as no-data, as the ratio explodes there.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</usage><parameters><param name="k_raster" displayname="K Raster" type="Required" direction="Input" datatype="GPRasterLayer" expression="k_raster"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Raster holding K.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Raster holding K.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="out_raster" displayname="Output Raster" type="Required" direction="Output" datatype="DERasterDataset" expression="out_raster"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Output raster, on the K raster's grid.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Output raster, on the K raster's grid.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="k_band" displayname="K Band" type="Required" direction="Input" datatype="GPLong" expression="k_band"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Band of the K raster holding K.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Band of the K raster holding K.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="u_raster" displayname="eU Raster" type="Required" direction="Input" datatype="GPRasterLayer" expression="u_raster"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Raster holding eU.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Raster holding eU.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="u_band" displayname="eU Band" type="Required" direction="Input" datatype="GPLong" expression="u_band"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Band of the eU raster holding eU.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Band of the eU raster holding eU.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="th_raster" displayname="eTh Raster" type="Required" direction="Input" datatype="GPRasterLayer" expression="th_raster"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Raster holding eTh.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Raster holding eTh.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="th_band" displayname="eTh Band" type="Required" direction="Input" datatype="GPLong" expression="th_band"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Band of the eTh raster holding eTh.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Band of the eTh raster holding eTh.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="element" displayname="Element" type="Required" direction="Input" datatype="GPString" expression="element"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Kd (anomalous potassium) or Ud (anomalous uranium).&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Kd (anomalous potassium) or Ud (anomalous uranium).&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param><param name="background" displayname="Background predicted from eTh by" type="Required" direction="Input" datatype="GPString" expression="background"><dialogReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Ratio of means: Ks = (mean K / mean eTh) x eTh. Linear regression: Ks = a + b x eTh, fitted by least squares.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</dialogReference><pythonReference>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Ratio of means: Ks = (mean K / mean eTh) x eTh. Linear regression: Ks = a + b x eTh, fitted by least squares.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</pythonReference></param></parameters></tool><dataIdInfo><idCitation><resTitle>Kd / Ud (Thorium-Normalised Deviation)</resTitle></idCitation><idAbs>&lt;DIV STYLE="text-align:Left;"&gt;&lt;DIV&gt;&lt;P&gt;&lt;SPAN&gt;Kd or Ud, the thorium-normalised deviation of K or eU (Saunders et al. 1987; Pires 1995): Kd = (K - Ks) / Ks, with Ks the K predicted from eTh over the whole grid. Positive where there is more K (or U) than the thorium predicts for the rock type.&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&lt;/DIV&gt;</idAbs><searchKeys><keyword>SGTool</keyword><keyword>geophysics</keyword></searchKeys><idPurp>Kd or Ud, the thorium-normalised deviation of K or eU (Saunders et al. 1987; Pires 1995): Kd = (K - Ks) / Ks, with Ks the K predicted from eTh over the whole grid. Positive where there is more K (or U) than the thorium predicts for the rock type.</idPurp></dataIdInfo><distInfo><distributor><distorFormat><formatName>ArcToolbox Tool</formatName></distorFormat></distributor></distInfo><mdHrLv><ScopeCd value="005"/></mdHrLv></metadata>
